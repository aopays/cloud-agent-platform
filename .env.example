APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
APP_BEARER_TOKEN=local-demo-token
SANDBOX_BACKEND=local
REPOSITORY_IMPORT_ROOT=examples
REPOSITORY_ALLOWED_HOSTS=github.com,gitlab.com
TASK_MAX_WALL_TIME_SECONDS=900
TASK_MAX_AGENT_TURNS=30
TASK_MAX_TOOL_OUTPUT_BYTES=65536
ARTIFACT_ROOT=.artifacts
RUN_ROOT=.runs
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
